index 0000000..a56fa83
--- /dev/null
+++ b/tools/spin8/test_native_codec.py
@@ -0,0 +1,199 @@
+"""Independent NumPy checks for native compressed CPU operators."""
+from __future__ import annotations
+import argparse
+import ctypes as C
+import json
+from pathlib import Path
+import sys
+import subprocess
+import tempfile
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import reference_codec as ref
+
+
+def payload(packed):
+    data = np.empty((len(packed["scales"]), 34), dtype=np.uint8)
+    data[:, :32] = packed["words"].astype("<u2").view(np.uint8).reshape(-1, 32)
+    data[:, 32:] = packed["scales"].astype("<f2").view(np.uint8).reshape(-1, 2)
+    return data
+
+
+def precise_decode(packed):
+    words = packed["words"].astype(np.int64)
+    uniform = np.signbit(packed["scales"])
+    safe = np.where(uniform[:, None], 0, words)
+    identity = safe >= 59049
+    frames = np.where(identity, 9, safe // 6561)
+    ranks = safe % 6561
+    ranks[identity] = ref.IDENTITY_RANKS[safe[identity] - 59049]
+    coefficients = ref.ALL_TERNARY[ranks].astype(np.float64)
+    frames[uniform] = 9
+    coefficients[uniform] = ((words[uniform, :, None] >> (2 * np.arange(8))) & 3) - 1.5
+    bank = np.concatenate((packed["bank"], np.eye(8)[None]))
+    values = np.einsum("gbo,gboi->gbi", coefficients, bank[frames])
+    values *= np.abs(packed["scales"].astype(np.float64))[:, None, None]
+    h = np.ones((1, 1))
+    for _ in range(7):
+        h = np.block([[h, h], [h, -h]])
+    return (values.reshape(-1, 128) @ (h / np.sqrt(128))).reshape(packed["shape"])
+
+
+def configure(lib):
+    p = C.c_void_p
+    lib.spin8_g128_validate_f64.argtypes = [p, C.c_size_t, p, C.c_size_t, C.c_int64, C.c_int64]
+    lib.spin8_g128_validate_f64.restype = C.c_int
+    lib.spin8_g128_dot_f64.argtypes = [p, p, p, C.c_int64]
+    lib.spin8_g128_dot_f64.restype = C.c_double
+    lib.spin8_g128_decode_row_f32.argtypes = [p, p, p, C.c_int64]
+    lib.spin8_g128_decode_row_f32.restype = None
+    lib.spin8_g128_matmul_cpu_f64.argtypes = [p, C.c_size_t, p, p, C.c_size_t, p, C.c_size_t, *([C.c_int64] * 5)]
+    lib.spin8_g128_matmul_cpu_f64.restype = C.c_int
+    lib.spin8_g128_identity_rank.argtypes = [C.c_int]
+    lib.spin8_g128_identity_rank.restype = C.c_int
+    lib.spin8_g128_scale_value.argtypes = [C.c_uint16, C.POINTER(C.c_double)]
+    lib.spin8_g128_scale_value.restype = C.c_int
+
+
+def validate(lib, raw, bank, rows, width, size=None):
+    return lib.spin8_g128_validate_f64(raw.ctypes.data, raw.nbytes if size is None else size,
+                                      bank.ctypes.data, bank.size, rows, width)
+
+
+def decoded_rows(lib, packed, raw):
+    rows, width = packed["shape"]
+    out = np.empty((rows, width), dtype=np.float32)
+    for row in range(rows):
+        lib.spin8_g128_decode_row_f32(raw.ctypes.data + row * (width // 128 * 34),
+                                     packed["bank"].ctypes.data, out[row].ctypes.data, width)
+    return out
+
+
+def run(lib):
+    configure(lib)
+    rng = np.random.default_rng(20261120)
+    bank = ref.make_bank()
+    ranks = np.asarray([lib.spin8_g128_identity_rank(i) for i in range(6449)])
+    np.testing.assert_array_equal(ranks, ref.IDENTITY_RANKS)
+    assert lib.spin8_g128_identity_rank(-1) == -1
+    assert lib.spin8_g128_identity_rank(6449) == -1
+    half = np.arange(65536, dtype=np.uint16).view(np.float16).astype(np.float64)
+    magnitude = C.c_double()
+    valid_scales = 0
+    for bits in range(65536):
+        status = lib.spin8_g128_scale_value(bits, C.byref(magnitude))
+        if np.isfinite(half[bits]) and half[bits] != 0:
+            assert status == 0 and magnitude.value == abs(half[bits]), bits
+            valid_scales += 1
+        else:
+            assert status == 3, bits
+    codes = {}
+    for mode, count, sign in (("ternary", 65498, 1), ("uniform", 65536, -1)):
+        groups = (count + 15) // 16
+        words = np.zeros(groups * 16, dtype=np.uint16)
+        words[:count] = np.arange(count, dtype=np.uint16)
+        packed = {"words": words.reshape(groups, 16), "scales": np.full(groups, sign, dtype=np.float16),
+                  "bank": bank, "shape": (groups, 128), "group_size": 128,
+                  "hadamard": True, "identity_fallback": True, "uniform_fallback": True}
+        raw = payload(packed)
+        assert validate(lib, raw, bank, groups, 128) == 0
+        native = decoded_rows(lib, packed, raw)
+        canonical = ref.decode(packed)
+        np.testing.assert_allclose(native, canonical, rtol=2e-6, atol=2e-6)
+        codes[mode] = {"codewords_checked": count, "decode_max_abs": float(np.max(np.abs(native - canonical)))}
+    weights = rng.normal(scale=0.1, size=(7, 384))
+    weights[1] = 0
+    weights[2, 7] = 3
+    packed = ref.encode(weights, bank)
+    raw = payload(packed)
+    precise = precise_decode(packed)
+    native = decoded_rows(lib, packed, raw)
+    np.testing.assert_allclose(native, ref.decode(packed), rtol=2e-6, atol=2e-7)
+    np.testing.assert_array_equal(native[1], np.zeros(384, dtype=np.float32))
+    x = rng.normal(size=(4, 391))
+    output = np.full((4, 10), 123456.0)
+    status = lib.spin8_g128_matmul_cpu_f64(raw.ctypes.data, raw.nbytes, bank.ctypes.data,
+                                          x.ctypes.data, x.size, output.ctypes.data, output.size,
+                                          7, 384, 4, 391, 10)
+    assert status == 0
+    expected = x[:, :384] @ precise.T
+    np.testing.assert_allclose(output[:, :7], expected, rtol=2e-12, atol=2e-12)
+    np.testing.assert_array_equal(output[:, 7:], np.full((4, 3), 123456.0))
+    row_bytes = 384 // 128 * 34
+    x32 = x[:, :384].copy().astype(np.float32)
+    row_result = np.asarray([[lib.spin8_g128_dot_f64(raw.ctypes.data + row * row_bytes,
+                                                   bank.ctypes.data, token.ctypes.data, 384)
+                              for row in range(7)] for token in x32])
+    expected_row = x32.astype(np.float64) @ precise.T
+    np.testing.assert_allclose(row_result, expected_row, rtol=2e-12, atol=2e-12)
+    canonical_linear = x32 @ ref.decode(packed).T
+    native_linear = row_result.astype(np.float32)
+    np.testing.assert_allclose(native_linear, canonical_linear, rtol=2e-5, atol=2e-6)
+    rejected = []
+    for label, bits in (("positive_zero_scale", 0), ("negative_zero_scale", 0x8000),
+                        ("infinite_scale", 0x7c00), ("nan_scale", 0x7e00)):
+        bad = raw.copy()
+        bad[0, 32:] = np.asarray([bits], dtype="<u2").view(np.uint8)
+        assert validate(lib, bad, bank, 7, 384) == 3
+        rejected.append(label)
+    for word in range(65498, 65536):
+        bad = raw.copy()
+        bad[0, :2] = np.asarray([word], dtype="<u2").view(np.uint8)
+        bad[0, 33] &= 0x7f
+        assert validate(lib, bad, bank, 7, 384) == 4
+        bad[0, 33] |= 0x80
+        assert validate(lib, bad, bank, 7, 384) == 0
+    rejected.append("all_38_reserved_positive_scale_codewords")
+    for label, bad_bank in (("nonorthogonal_bank", bank * 1.01),
+                            ("nan_bank", np.full_like(bank, np.nan)),
+                            ("infinite_bank", np.full_like(bank, np.inf))):
+        assert validate(lib, raw, bad_bank, 7, 384) == 5
+        rejected.append(label)
+    reflection = bank.copy()
+    reflection[0, 0] *= -1
+    assert validate(lib, raw, reflection, 7, 384) == 5
+    rejected.append("reflection_bank")
+    assert validate(lib, raw, bank, 7, 383) == 2
+    assert validate(lib, raw, bank, 0, 384) == 2
+    assert validate(lib, raw, bank, 2**63 - 1, 2**62) == 2
+    assert validate(lib, raw, bank, 7, 384, raw.nbytes - 1) == 1
+    rejected.extend(("invalid_shape", "zero_rows", "dimension_overflow", "truncated_payload"))
+    bad_x = x.copy()
+    bad_x[1, 4] = np.nan
+    assert lib.spin8_g128_matmul_cpu_f64(raw.ctypes.data, raw.nbytes, bank.ctypes.data,
+                                        bad_x.ctypes.data, bad_x.size, output.ctypes.data, output.size,
+                                        7, 384, 4, 391, 10) == 6
+    rejected.append("nonfinite_activation")
+    assert lib.spin8_g128_matmul_cpu_f64(raw.ctypes.data, raw.nbytes, bank.ctypes.data,
+                                        x.ctypes.data, 12, output.ctypes.data, output.size,
+                                        7, 384, 4, 391, 10) == 1
+    rejected.append("short_activation_buffer")
+    return {"scope": "native CPU compressed operators; no GPU execution or LLM quality measurement",
+            "all_identity_ranks_checked": len(ranks), "all_fp16_patterns_checked": 65536,
+            "valid_finite_nonzero_fp16_scales": valid_scales, "codeword_decoding": codes,
+            "matrix_shape": [7, 384], "tokens": 4,
+            "f64_matmul_max_abs": float(np.max(np.abs(output[:, :7] - expected))),
+            "f64_row_dot_f32_activation_max_abs": float(np.max(np.abs(row_result - expected_row))),
+            "f32_output_vs_canonical_matmul_max_abs": float(np.max(np.abs(native_linear - canonical_linear))),
+            "strided_activation_and_output_checked": True,
+            "rejected_invalid_cases": rejected, "cuda_executed": False, "full_model_evaluation": False}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--library", type=Path, default=None)
+    parser.add_argument("--report", type=Path, default=Path("native-codec-selfcheck.json"))
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix="spin8-native-check-") as directory:
+        library = args.library
+        if library is None:
+            library = Path(directory) / "libspin8-reference.so"
+            subprocess.run(["c++", "-std=c++17", "-O2", "-shared", "-fPIC",
+                            str(ROOT / "ggml/src/ggml-spin8.cpp"),
+                            "-I" + str(ROOT / "ggml/include"), "-o", str(library)], check=True)
+        report = run(C.CDLL(str(library.resolve())))
+    text = json.dumps(report, indent=2) + "\n"
+    args.report.write_text(text)
+    print(text, end="")
diff --git a/tools/spin8/test_projection.py b/tools/spin8/test_projection.py
new file mode 100644
index 0000000..7b2da80
--- /dev/null
+++ b/tools/spin8/test_projection.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""Verify optional native weight projection against independently folded F32 weights.
+
+Uses a synthetic direction and a tiny fixture. This tests linear algebra and
+runtime integration, not refusal behavior or model capability.
+"""
+
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+import numpy as np
+
+import convert as bridge
+import gguf
+from test_loader import invoke as invoke_loader
+from verify_native import artifact
+
+HERE = Path(__file__).resolve().parent
+PREFIX = "spin8.projection."
+DIRECTION = PREFIX + "direction"
+NEGATIVE_CASES = (
+    "missing_version", "wrong_version_type", "unsupported_version",
+    "missing_direction", "wrong_direction_type", "wrong_direction_width",
+    "nonfinite_direction", "zero_direction", "invalid_left_name",
+    "invalid_right_name", "missing_target", "duplicate_target",
+    "wrong_array_type", "empty_targets",
+)
+
+
+def run(command: list[str], log: Path, timeout: int = 240) -> None:
+    with log.open("wb") as handle:
+        process = subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT,
+                                 check=False, timeout=timeout)
+    if process.returncode:
+        raise RuntimeError(f"Command failed ({process.returncode}); see {log}")
+
+
+def write_variant(reader: gguf.GGUFReader, path: Path, direction: np.ndarray,
+                  left: list[str], right: list[str], *, folded: bool = False,
+                  tied: bool = False, malformed: str = "") -> dict:
+    left, right = list(left), list(right)
+    if malformed == "invalid_left_name":
+        left = ["output.weight"]
+    elif malformed == "invalid_right_name":
+        right = ["output.weight"]
+    elif malformed == "missing_target":
+        left = ["blk.99.ffn_down.weight"]
+    elif malformed == "duplicate_target":
+        left += left[:1]
+    elif malformed == "empty_targets":
+        left, right = [], []
+    stored = np.asarray(direction, dtype="<f4").copy()
+    if malformed == "wrong_direction_width":
+        stored = stored[:-1]
+    elif malformed == "nonfinite_direction":
+        stored[0] = np.nan
+    elif malformed == "zero_direction":
+        stored[:] = 0
+    # Match load-time normalization, then independently materialize I-u*u^T.
+    unit = stored.astype(np.float64)
+    if folded:
+        unit = (unit / np.linalg.norm(unit)).astype(np.float32).astype(np.float64)
+    writer = gguf.GGUFWriter(path, "qwen35")
+    tensors = []
+    max_relative_component = 0.0
+    try:
+        for name, field in reader.fields.items():
+            if name.startswith(("GGUF.", PREFIX)) or name == "general.architecture":
+                continue
+            subtype = field.types[1] if field.types[0] == gguf.GGUFValueType.ARRAY else None
+            writer.add_key_value(name, field.contents(), field.types[0], sub_type=subtype)
+        if not folded:
+            if malformed == "wrong_version_type":
+                writer.add_int32(PREFIX + "version", 1)
+            elif malformed != "missing_version":
+                writer.add_uint32(PREFIX + "version", 2 if malformed == "unsupported_version" else 1)
+            writer.add_string(PREFIX + "kind", "residual_direction_removal")
+            if malformed == "wrong_array_type":
+                writer.add_string(PREFIX + "left_weights", "invalid")
+            else:
+                writer.add_key_value(PREFIX + "left_weights", left, gguf.GGUFValueType.ARRAY,
+                                     sub_type=gguf.GGUFValueType.STRING)
+            writer.add_key_value(PREFIX + "right_weights", right, gguf.GGUFValueType.ARRAY,
+                                 sub_type=gguf.GGUFValueType.STRING)
+        for tensor in reader.tensors:
+            if tensor.name == DIRECTION or (tied and tensor.name in ("output.weight", "output.weight.spin8_bank")):
+                continue
+            data, kind = tensor.data, tensor.tensor_type
+            if folded and (tensor.name in left or tensor.name in right):
+                if kind != gguf.GGMLQuantizationType.F32:
+                    raise ValueError("Folded control must use F32 decoded matrices")
+                matrix = data.astype(np.float64)
+                if tensor.name in left:
+                    matrix -= unit[:, None] * (unit @ matrix)[None, :]
+                    component = unit @ matrix
+                else:
+                    matrix -= (matrix @ unit)[:, None] * unit[None, :]
+                    component = matrix @ unit
+                max_relative_component = max(max_relative_component,
+                    float(np.linalg.norm(component) / max(np.linalg.norm(matrix), 1e-30)))
+                data = matrix.astype("<f4")
+            writer.add_tensor_info(tensor.name, data.shape, data.dtype, data.nbytes, raw_dtype=kind)
+            tensors.append(data)
+        if not folded and malformed != "missing_direction":
+            if malformed == "wrong_direction_type":
+                stored = stored.astype("<f8")
+            writer.add_tensor_info(DIRECTION, stored.shape, stored.dtype, stored.nbytes)
+            tensors.append(stored)
+        writer.write_header_to_file()
+        writer.write_kv_data_to_file()
+        writer.write_ti_data_to_file()
+        for data in tensors:
+            writer.write_tensor_data(data)
+    finally:
+        writer.close()
+    return {"max_relative_direction_component_of_folded_weights": max_relative_component}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", required=True, type=Path)
+    parser.add_argument("--float-fixture", required=True, type=Path)
+    parser.add_argument("--out-dir", required=True, type=Path)
+    args = parser.parse_args()
+    args.binary = args.binary.resolve(strict=True)
+    args.float_fixture = args.float_fixture.resolve(strict=True)
+    args.out_dir = args.out_dir.resolve()
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    if args.float_fixture.stat().st_size > 32*1024*1024:
+        parser.error("Use a tiny float fixture of at most 32 MiB")
+    if any(args.out_dir.iterdir()):
+        parser.error("Use a new empty output directory")
+    report = {"schema": "spin8-native-projection-test-v1", "status": "FAIL",
+              "timestamp_utc": datetime.now(timezone.utc).isoformat(),
+              "scope": "synthetic-direction linear algebra and tiny Qwen35 graph; no behavioral claim",
+              "runtime_executable": artifact(args.binary), "source": artifact(args.float_fixture),
+              "parity": [], "loader_rejections": []}
+    try:
+        source = bridge.open_source(args.float_fixture, native=False)
+        hidden = int(source.fields["qwen35.embedding_length"].contents())
+        direction = np.random.default_rng(2048).normal(size=hidden).astype("<f4")
+        np.save(args.out_dir / "synthetic-direction.npy", direction)
+        edited = args.out_dir / "edited-f32.gguf"
+        native = args.out_dir / "edited-spin8.gguf"
+        decoded = args.out_dir / "edited-decoded.gguf"
+        run([sys.executable, str(HERE / "edit_weights.py"), str(args.float_fixture), str(edited),
+             "--remove-direction", str(args.out_dir / "synthetic-direction.npy"), "--outtype", "f32"],
+            args.out_dir / "edit.log")
+        run([sys.executable, str(HERE / "convert.py"), "quantize", str(edited), str(native),
+             "--decoded-control", str(decoded), "--include-embedding", "--scale-steps", "5"],
+            args.out_dir / "quantize.log")
+        actual_reader = bridge.open_source(native, native=True)
+        control_reader = bridge.open_source(decoded, native=False)
+        left = [t.name for t in actual_reader.tensors
+                if re.fullmatch(r"blk\.\d+\.(attn_output|ffn_down|ssm_out)\.weight", t.name)]
+        right = ["token_embd.weight"]
+        direction = next(t.data.copy() for t in actual_reader.tensors if t.name == DIRECTION)
+        prefix = args.out_dir / "no-alloc"
+        run([str(args.binary), "--model", str(native), "--output-prefix", str(prefix),
+             "--ngl", "0", "--no-alloc", "--no-mmap"], args.out_dir / "no-alloc-console.log")
+        no_alloc = json.loads(Path(str(prefix) + ".json").read_text())
+        no_alloc_log = Path(str(prefix) + ".log").read_text()
+        if not (no_alloc.get("no_alloc_graph_created") and "load_tensors_spin8_projection:" in no_alloc_log):
+            raise RuntimeError("Memory-fit graph did not report active projection bindings")
+        report["no_alloc"] = {"status": no_alloc["status"], "graph_created": True,
+                              "tensor_execution": False, "report": str(prefix) + ".json"}
+        variants = [("both", left, right, False, 3.75),
+                    ("left_only", left, [], False, 1.0),
+                    ("right_only", [], right, False, 1.0),
+                    ("tied_head", left, right, True, 1.0),
+                    ("small_direction", left, right, False, 1e-30)]
+        for name, ls, rs, tied, scale in variants:
+            variant = args.out_dir / (name + ".gguf")
+            control = args.out_dir / (name + "-folded-f32.gguf")
+            scaled = direction * np.float32(scale)
+            write_variant(actual_reader, variant, scaled, ls, rs, tied=tied)
+            algebra = write_variant(control_reader, control, scaled, ls, rs, folded=True, tied=tied)
+            target = args.out_dir / name
+            command = [sys.executable, str(HERE / "verify_native.py"), "--binary", str(args.binary),
+                       "--model", str(variant), "--control", str(control), "--out-dir", str(target),
+                       "--ngl", "0", "--control-ngl", "0", "--threads", "2",
+                       "--mmap" if name in ("both", "tied_head") else "--no-mmap"]
+            run(command, args.out_dir / (name + "-parity.log"))
+            parity = json.loads((target / "parity.json").read_text())
+            report["parity"].append({"case": name, "status": parity["status"],
+                                    "comparison": parity.get("comparison"), "report": str(target / "parity.json"),
+                                    **algebra})
+        for case in NEGATIVE_CASES:
+            variant = args.out_dir / ("bad-" + case + ".gguf")
+            write_variant(actual_reader, variant, direction, left, right, malformed=case)
+            runs = [invoke_loader(args.binary, variant, args.out_dir / (case + "-" + mode), mapped, True)
+                    for mapped, mode in ((False, "no-mmap"), (True, "mmap"))]
+            report["loader_rejections"].append({"case": case, "runs": runs,
+                "status": "PASS" if all(r["status"] == "PASS" for r in runs) else "FAIL"})
+        report["source_unchanged"] = artifact(args.float_fixture) == report["source"]
+        report["status"] = "PASS" if (report["source_unchanged"] and
+            all(r["status"] == "PASS" for r in report["parity"] + report["loader_rejections"])) else "FAIL"
+    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
+        report["error"] = str(error)
+    output = args.out_dir / "projection-tests.json"
+    output.write_text(json.dumps(report, indent=2, allow_nan=False) + "\n")
+    print(json.dumps({"status": report["status"], "parity_cases": len(report["parity"]),
+                      "negative_cases": len(report["loader_rejections"]), "report": str(output),
+                      "error": report.get("error")}))
+    return 0 if report["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
